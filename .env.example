# =====================================================
# Variáveis de ambiente — Costa & Souza Site
# Copiar para .env.local em desenvolvimento.
# Em produção/staging, usar Cloudflare Secrets + wrangler.toml vars.
# =====================================================

# -----------------------------------------------------
# Site / Negócio (públicas — prefixo VITE_)
# -----------------------------------------------------
VITE_SITE_URL=http://localhost:3000
VITE_WHATSAPP_NUMBER=5562000000000
VITE_WHATSAPP_MESSAGE=Olá, gostaria de falar com um especialista em vistos americanos.

# -----------------------------------------------------
# Analytics (públicas — prefixo VITE_)
# -----------------------------------------------------
VITE_GA_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXX

# -----------------------------------------------------
# Segurança (pública no client, secreta no server)
# -----------------------------------------------------
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# -----------------------------------------------------
# Somente servidor (Cloudflare Secrets / .env.local dev)
# -----------------------------------------------------
LEAD_WEBHOOK_URL=https://hooks.zapier.com/...
LEAD_EMAIL=contato@costaesouzavistos.com
TURNSTILE_SECRET_KEY=0x4AAAAAA...
RESEND_API_KEY=re_...
AUTHORITY_ENGINE_API_KEY=...
